# Copy to .env at the repo root. Defaults work for local native demos (and Docker if used).
# Do not commit real secrets.

# JWT — must match across gateway + all services
JWT_SECRET=wJjY8fXo+G6Vkhd4yLh3JOp6tH8l29PY5zR0DboYdxM=

# PostgreSQL (native: localhost:5432 — create DB EliteSchool yourself)
DB_USERNAME=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432
DB_NAME=EliteSchool

# Frontend URL (reset-email links) + CORS (comma-separated origins)
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# SMTP (Forgot Password only — optional for core demo)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=EliteSchool Support

# Native runs only (Compose sets these itself)
CONSUL_HOST=localhost
CONSUL_PORT=8500

# Optional JVM heaps for Docker (defaults balanced for ~16GB machines + browser demos)
# Prefer Java 25 Temurin; Compact Object Headers are enabled in Compose defaults.
# JAVA_OPTS=-Xms64m -Xmx320m -XX:+UseG1GC -XX:+UseCompactObjectHeaders
# AUTH_JAVA_OPTS=-Xms64m -Xmx384m -XX:+UseG1GC -XX:+UseCompactObjectHeaders
# GATEWAY_JAVA_OPTS=-Xms64m -Xmx256m -XX:+UseG1GC -XX:+UseCompactObjectHeaders

# Stack: Java 25 · Node 22.22.3+ · Spring Boot 4.1 · Angular 22.1 · PrimeNG 22
# Native helper: demo-native.bat · Docs: README.md · USAGE_GUIDE.md
